diff --git a/common/tls/reality_compat.go b/common/tls/reality_compat.go
new file mode 100644
index 0000000..7c8acf6
--- /dev/null
+++ b/common/tls/reality_compat.go
@@ -0,0 +1,134 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"context"
+	"sync/atomic"
+	"time"
+
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	aTLS "github.com/sagernet/sing/common/tls"
+)
+
+// Scoped to this outbound and its clones; never persisted in a profile.
+// 0 = untested, 1 = modern worked, 2 = authenticated legacy Chrome worked.
+type realityChromeCompatibility struct {
+	mode atomic.Uint32
+	gate chan struct{}
+}
+
+func (e *RealityClientConfig) dialWithCompatibility(ctx context.Context, dialer N.Dialer, destination M.Socksaddr) (Conn, error) {
+	policy := e.chromeCompatibility
+	if policy == nil {
+		return e.dialRealityAttempt(ctx, dialer, destination)
+	}
+	if timeout := e.HandshakeTimeout(); timeout > 0 {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, timeout)
+		defer cancel()
+	}
+	if policy.mode.Load() == 0 {
+		select {
+		case policy.gate <- struct{}{}:
+			defer func() { <-policy.gate }()
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	legacy := e.Clone().(*RealityClientConfig)
+	legacy.legacyChrome = true
+	if policy.mode.Load() == 2 {
+		conn, err := legacy.dialRealityAttempt(ctx, dialer, destination)
+		if err == nil || ctx.Err() != nil {
+			return conn, err
+		}
+		// A server may have been upgraded while this VPN session was running.
+		policy.mode.CompareAndSwap(2, 0)
+		return e.dialRealityAttempt(ctx, dialer, destination)
+	}
+	type result struct {
+		conn   Conn
+		err    error
+		legacy bool
+	}
+	attemptCtx, cancel := context.WithCancel(ctx)
+	results := make(chan result, 2)
+	started, received := 1, 0
+	start := func(config *RealityClientConfig) {
+		go func() {
+			conn, err := config.dialRealityAttempt(attemptCtx, dialer, destination)
+			results <- result{conn, err, config.legacyChrome}
+		}()
+	}
+	defer func() {
+		cancel()
+		// Every attempt always sends once to the buffered channel, including
+		// cancellation. Dispose the losing socket even if it just authenticated.
+		pending := started - received
+		if pending > 0 {
+			go func() {
+				for i := 0; i < pending; i++ {
+					r := <-results
+					if r.conn != nil {
+						r.conn.Close()
+					}
+				}
+			}()
+		}
+	}()
+	start(e)
+	timer := time.NewTimer(time.Second)
+	defer timer.Stop()
+	timerC := timer.C
+	startLegacy := func() {
+		if started == 1 {
+			started++
+			start(legacy)
+		}
+		timerC = nil
+	}
+	for {
+		select {
+		case r := <-results:
+			received++
+			if r.err == nil {
+				// Both variants return only after the normal REALITY certificate
+				// MAC verification. TCP/TLS success alone never learns a mode.
+				if r.legacy {
+					policy.mode.Store(2)
+				} else {
+					policy.mode.CompareAndSwap(0, 1)
+				}
+				return r.conn, nil
+			}
+			if ctx.Err() != nil {
+				return nil, ctx.Err()
+			}
+			startLegacy()
+			if received == started {
+				return nil, r.err
+			}
+		case <-timerC:
+			// Keep the modern attempt alive: slow modern-only servers retain
+			// their original budget instead of restarting after a probe timeout.
+			startLegacy()
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+}
+
+func (e *RealityClientConfig) dialRealityAttempt(ctx context.Context, dialer N.Dialer, destination M.Socksaddr) (Conn, error) {
+	conn, err := dialer.DialContext(ctx, N.NetworkTCP, destination)
+	if err != nil {
+		return nil, err
+	}
+	tlsConn, err := aTLS.ClientHandshake(ctx, conn, e)
+	if err != nil {
+		conn.Close()
+		return nil, err
+	}
+	return tlsConn, nil
+}
