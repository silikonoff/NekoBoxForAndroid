new file mode 100644
index 0000000000000000000000000000000000000000..c42c2951941efbc10508df2e70ad30d1f7c9c3b8
--- /dev/null
+++ b/boxapi/v2ray_stats_service_test.go
@@ -0,0 +1,57 @@
+package boxapi
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+)
+
+type taggedOutbound struct {
+	adapter.Outbound
+	tag string
+}
+
+func (o taggedOutbound) Tag() string { return o.tag }
+
+// Native TUN flow offload must not bypass the counters displayed by NekoBox.
+func TestFlowTrafficAndReset(t *testing.T) {
+	s := NewSbStatsService(option.V2RayStatsServiceOptions{Enabled: true, Outbounds: []string{"proxy"}})
+	f := s.RoutedFlow(context.Background(), adapter.InboundContext{}, nil, taggedOutbound{tag: "proxy"})
+	if f == nil {
+		t.Fatal("tracked outbound has no flow tracker")
+	}
+	f.CountForward(137)
+	f.CountReverse(293)
+	for direction, want := range map[string]int64{"uplink": 137, "downlink": 293} {
+		name := "outbound>>>proxy>>>traffic>>>" + direction
+		got, err := s.GetStats(context.Background(), name, true)
+		if err != nil || got != want {
+			t.Fatalf("%s: got %d, %v; want %d", direction, got, err, want)
+		}
+		got, err = s.GetStats(context.Background(), name, false)
+		if err != nil || got != 0 {
+			t.Fatalf("%s counter did not reset: %d, %v", direction, got, err)
+		}
+	}
+}
+
+func TestFlowDoesNotCountUnselectedOutbound(t *testing.T) {
+	s := NewSbStatsService(option.V2RayStatsServiceOptions{Enabled: true, Outbounds: []string{"proxy"}})
+	if s.RoutedFlow(context.Background(), adapter.InboundContext{}, nil, taggedOutbound{tag: "direct"}) != nil {
+		t.Fatal("unexpected accounting for an untracked outbound")
+	}
+}
+
+func TestFlowAccountsInboundAndUser(t *testing.T) {
+	s := NewSbStatsService(option.V2RayStatsServiceOptions{Enabled: true, Inbounds: []string{"tun"}, Users: []string{"test-user"}})
+	f := s.RoutedFlow(context.Background(), adapter.InboundContext{Inbound: "tun", User: "test-user"}, nil, taggedOutbound{tag: "proxy"})
+	f.CountForward(71)
+	for _, name := range []string{"inbound>>>tun>>>traffic>>>uplink", "user>>>test-user>>>traffic>>>uplink"} {
+		got, err := s.GetStats(context.Background(), name, false)
+		if err != nil || got != 71 {
+			t.Fatalf("%s: got %d, %v", name, got, err)
+		}
+	}
+}
